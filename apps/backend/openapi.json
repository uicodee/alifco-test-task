{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/register": {
      "post": {
        "operationId": "authRegister",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signed in: session cookies are set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "AUTH_EMAIL_TAKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "Create an account with email and password, and sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "authLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in: session cookies are set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_INVALID_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "Sign in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "authRefresh",
        "parameters": [],
        "responses": {
          "204": {
            "description": "New session cookies are set"
          },
          "401": {
            "description": "AUTH_SESSION_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          },
          {
            "refresh_token": []
          }
        ],
        "summary": "Rotate the refresh token and issue a new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Session revoked and cookies cleared"
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "Sign out on this device",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "authMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "The signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/password": {
      "post": {
        "description": "Accounts created with Google or Facebook have no password: this adds one, so they can also sign in with email and password. Changing an existing password requires `currentPassword`. Every other session of the user is ended; this device stays signed in.",
        "operationId": "authSetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user, now with `hasPassword: true`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "400": {
            "description": "AUTH_CURRENT_PASSWORD_REQUIRED, AUTH_CURRENT_PASSWORD_INVALID or AUTH_EMAIL_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "summary": "Set a password on the account, or change it",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/providers": {
      "get": {
        "operationId": "oAuthProviders",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProvidersDto"
                }
              }
            }
          }
        },
        "summary": "Which social sign-in providers are configured",
        "tags": [
          "oauth"
        ]
      }
    },
    "/api/auth/oauth/{provider}": {
      "get": {
        "operationId": "oAuthStart",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/OAuthProvider"
            }
          },
          {
            "name": "next",
            "required": false,
            "in": "query",
            "description": "Same-site path to return to after signing in",
            "schema": {
              "maxLength": 512,
              "example": "/account",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the provider's consent page"
          },
          "404": {
            "description": "AUTH_PROVIDER_DISABLED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Start social sign-in: redirects to the provider",
        "tags": [
          "oauth"
        ]
      }
    },
    "/api/auth/oauth/{provider}/callback": {
      "get": {
        "operationId": "oAuthCallback",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/OAuthProvider"
            }
          },
          {
            "name": "code",
            "required": false,
            "in": "query",
            "description": "Authorization code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": false,
            "in": "query",
            "description": "State issued by the start endpoint",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "required": false,
            "in": "query",
            "description": "Set when the user cancelled",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error_description",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the app, or to /login?error=<code>&provider=<provider>"
          }
        },
        "summary": "Provider redirect target: signs in and redirects to the app",
        "tags": [
          "oauth"
        ]
      }
    }
  },
  "info": {
    "title": "Alifco Auth API",
    "description": "Email + password and social (Google, Facebook, Telegram) sign-in. Sessions live in httpOnly cookies: `access_token` (short-lived JWT) and `refresh_token` (rotated on every refresh).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token (the `access_token` cookie value)"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token",
        "description": "Set by the login, register and OAuth callback endpoints"
      },
      "refresh_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "TOO_MANY_REQUESTS",
          "VALIDATION_FAILED",
          "INTERNAL_ERROR",
          "HTTP_ERROR",
          "USER_NOT_FOUND",
          "AUTH_TOKEN_INVALID",
          "AUTH_SESSION_EXPIRED",
          "AUTH_INVALID_CREDENTIALS",
          "AUTH_EMAIL_TAKEN",
          "AUTH_EMAIL_REQUIRED",
          "AUTH_CURRENT_PASSWORD_REQUIRED",
          "AUTH_CURRENT_PASSWORD_INVALID",
          "AUTH_PROVIDER_DISABLED"
        ]
      },
      "ApiErrorReasonCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "too_many_requests",
          "validation_failed",
          "internal_error",
          "http_error",
          "user_not_found",
          "auth_token_invalid",
          "auth_session_expired",
          "auth_invalid_credentials",
          "auth_email_taken",
          "auth_email_required",
          "auth_current_password_required",
          "auth_current_password_invalid",
          "auth_provider_disabled"
        ]
      },
      "ApiErrorReasonDto": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiErrorReasonCode"
              }
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 422
          },
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiErrorCode"
              }
            ]
          },
          "reason": {
            "$ref": "#/components/schemas/ApiErrorReasonDto"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "email": [
                "email must be an email"
              ]
            }
          },
          "path": {
            "type": "string",
            "example": "/api/auth/login"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "response_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "statusCode",
          "code",
          "reason"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "At least 8 characters, with a letter and a digit",
            "example": "correct-horse-7"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "OAuthProvider": {
        "type": "string",
        "enum": [
          "google",
          "facebook",
          "telegram"
        ],
        "description": "Social accounts linked to this user"
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "example": "ada@example.com"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          },
          "hasPassword": {
            "type": "boolean",
            "description": "Whether email + password sign-in is set up"
          },
          "providers": {
            "type": "array",
            "description": "Social accounts linked to this user",
            "items": {
              "$ref": "#/components/schemas/OAuthProvider"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified",
          "name",
          "avatarUrl",
          "hasPassword",
          "providers",
          "createdAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SetPasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128,
            "description": "Required when the account already has a password"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "The new password: at least 8 characters, with a letter and a digit",
            "example": "correct-horse-7"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "AuthProvidersDto": {
        "type": "object",
        "properties": {
          "google": {
            "type": "boolean",
            "description": "Google sign-in is configured"
          },
          "facebook": {
            "type": "boolean",
            "description": "Facebook sign-in is configured"
          },
          "telegram": {
            "type": "boolean",
            "description": "Telegram sign-in is configured"
          }
        },
        "required": [
          "google",
          "facebook",
          "telegram"
        ]
      }
    }
  }
}
