NODE_ENV=development
APP_PORT=4000
FRONTEND_URL=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=alifco_auth
POSTGRES_PASSWORD=alifco_auth
POSTGRES_DB=alifco_auth
POSTGRES_SSL=false

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_STATE_SECRET=change-me-oauth-state-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Google: https://console.cloud.google.com/apis/credentials (OAuth client, type "Web application")
# Authorized redirect URI: http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps (Facebook Login > Settings)
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Telegram: @BotFather > Bot Settings > Web Login (OpenID Connect)
# Allowed URL: http://localhost:3000/api/auth/oauth/telegram/callback
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
